{
	"name": "@uvl000/claude-trace",
	"version": "5.0.1",
	"description": "WorkflowExp fork for recording API traffic from Claude Code, OpenCode, and Codex CLI",
	"main": "dist/index.js",
	"bin": {
		"claude-trace": "dist/cli/cli.js",
		"opencode-trace": "dist/cli/opencode-cli.js",
		"codex-trace": "dist/cli/codex-cli.js",
		"vibe-coding-proxy": "dist/cli/vibe-coding-proxy-cli.js",
		"llm-trace": "dist/cli/llm-trace.js"
	},
	"scripts": {
		"build": "rm -rf dist && tsc && npm run build:frontend",
		"build:frontend": "cd frontend && npm run build",
		"setup": "npm install && cd frontend && npm install",
		"predev": "tsc",
		"dev": "concurrently \"npm run dev:core\" \"npm run dev:frontend\"",
		"dev:core": "tsc --watch --preserveWatchOutput",
		"dev:frontend": "cd frontend && npm run dev",
		"clean": "rm -rf dist",
		"prepublishOnly": "npm run clean && npm run build",
		"test": "npm run test:unit",
		"test:unit": "npx tsx --test test/*.test.ts",
		"test:generate": "node dist/cli/llm-trace.js --help",
		"typecheck": "tsc --noEmit",
		"pack:workflowexp": "bash scripts/pack-workflowexp.sh releases",
		"test:built": "node scripts/verify-built.cjs"
	},
	"files": [
		"dist/**/*",
		"frontend/dist/**/*",
		"frontend/template.html",
		"offline/bin/**/*",
		"README.md",
		"README.zh-CN.md",
		"MIGRATION.md"
	],
	"keywords": [
		"claude",
		"opencode",
		"codex",
		"anthropic",
		"logging",
		"api",
		"debugging",
		"http",
		"interception"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FlyingFish-233/claude-trace.git"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.52.0",
		"@types/node": "^20.0.0",
		"@types/node-forge": "^1.3.14",
		"concurrently": "^9.1.2",
		"nodemon": "^3.1.10",
		"tsx": "4.23.13",
		"typescript": "^5.0.0"
	},
	"directories": {
		"test": "test"
	},
	"types": "./dist/index.d.ts",
	"bugs": {
		"url": "https://github.com/FlyingFish-233/claude-trace/issues"
	},
	"homepage": "https://github.com/FlyingFish-233/claude-trace#readme",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"http-proxy-agent": "7.0.2",
		"https-proxy-agent": "7.0.6",
		"node-forge": "^1.4.0",
		"smol-toml": "^1.6.1"
	},
	"bundleDependencies": [
		"http-proxy-agent",
		"https-proxy-agent",
		"node-forge",
		"smol-toml"
	]
}
